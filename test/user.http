# @name login
POST http://localhost:3000/api/login
Content-Type: application/json

{
  "user_name": "admin",
  "password": "1234"
}

###


GET http://localhost:3000/api/users
Authorization: Bearer {{login.response.body.authorizationToken}}

###


POST http://localhost:3000/api/users
Authorization: Bearer {{login.response.body.authorizationToken}}
Content-Type: application/json

{
  "user_name": "Maria",
  "password": "1234",
  "display_name": "Maria Saavedra",
  "email": "maria23062006@example.com"
}
###
DELETE http://localhost:3000/api/users/Maria
Authorization: Bearer {{login.response.body.authorizationToken}}

###
PATCH http://localhost:3000/api/users/Lucas
Authorization: Bearer {{login.response.body.authorizationToken}}
Content-Type: application/json

{
  "user_name": "Lucas",
  "password": "1234",
  "display_name": "Lucas Despous",
  "email": "lolo@example.com",
  "role": "user"
}