# @name login
POST http://localhost:3000/api/login
Content-Type: application/json

{
  "user_name": "admin",
  "password": "Admin123!"
}

###

# @name createProduct
POST http://localhost:3000/api/producto
Authorization: Bearer {{login.response.body.authorizationToken}}
Content-Type: application/json

{
  "nombre": "Tafirol",
  "descripcion": "Este es un producto de prueba",
  "precio": 10,
  "stock": 100
}
###
PATCH http://localhost:3000/api/producto/{{createProduct.response.body.producto._id}}
Authorization: Bearer {{login.response.body.authorizationToken}}
Content-Type: application/json

{
  "precio": 12.5,
  "stock": 80
}
###
DELETE http://localhost:3000/api/producto/{{createProduct.response.body.producto._id}}
Authorization: Bearer {{login.response.body.authorizationToken}}
###
POST http://localhost:3000/api/producto
Authorization: Bearer {{login.response.body.authorizationToken}}
Content-Type: application/json

{
  "nombre": "Ibuprofeno",
  "descripcion": "Este es otro producto de prueba",
  "precio": 5.99,
  "stock": 50
}
###
GET http://localhost:3000/api/producto
Authorization: Bearer {{login.response.body.authorizationToken}}